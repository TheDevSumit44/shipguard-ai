# ═════════════════════════════════════════════════════════════
# BACKEND ENVIRONMENT CONFIGURATION (.env)
# ═════════════════════════════════════════════════════════════
# IMPORTANT: This file contains SENSITIVE credentials.
# DO NOT commit this file. It is protected by .gitignore.
# All values must be set before running backend.

# ═════════════ SERVER CONFIGURATION ═════════════
PORT=8787
NODE_ENV=development

# ═════════════ FIREBASE ADMIN SDK ═════════════
# Download service account JSON from:
# Firebase Console → Project Settings → Service Accounts → Generate New Private Key
# Store as backend/firebase-key.json (will be gitignored)
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-key.json
FIREBASE_PROJECT_ID=shipguard-ai-thedevsumit44

# Alternative: Set directly via environment variables (for cloud deployments)
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk@...
# FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...

# ═════════════ EXTERNAL API KEYS ═════════════
# OpenWeather API
# Get key from: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# News API
# Get key from: https://newsapi.org/
NEWS_API_KEY=your_news_api_key_here

# Google Maps API
# Get key from: https://cloud.google.com/maps-platform
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# OpenRouteService API
# Get key from: https://openrouteservice.org/
ORS_API_KEY=your_openrouteservice_api_key_here

# OSRM (Open Source Routing Machine)
# Public service - no key needed
OSRM_BASE_URL=https://router.project-osrm.org

# ═════════════ WEBHOOK SECURITY ═════════════
# Generate secure webhook secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WEBHOOK_SECRET=your_webhook_secret_here_min_32_chars

# Webhook processing options
WEBHOOK_REQUIRE_HMAC=true
WEBHOOK_ALLOW_LEGACY_SECRET=false
WEBHOOK_TIMESTAMP_TOLERANCE_SEC=300

# Webhook retry configuration
WEBHOOK_RETRY_ENABLED=true
WEBHOOK_RETRY_MAX_ATTEMPTS=6
WEBHOOK_RETRY_INTERVAL_SEC=60
WEBHOOK_RETRY_BATCH_SIZE=25

# ═════════════ RATE LIMITING ═════════════
# Requests per minute limits
API_RATE_LIMIT_PER_MINUTE=100
WEBHOOK_RATE_LIMIT_PER_MINUTE=120

# ═════════════ CORS CONFIGURATION ═════════════
# Comma-separated list of allowed origins
# Production: Use only HTTPS origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# ═════════════ PII ENCRYPTION ═════════════
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Used to encrypt customer and product names in database
PII_ENCRYPTION_KEY=your_pii_encryption_key_here_base64

# ═════════════ DATA RETENTION ═════════════
RETENTION_ENABLED=true
RETENTION_DAYS=365
RETENTION_RUN_EVERY_HOURS=24

# ═════════════ ERROR TRACKING (Optional) ═════════════
# Sentry for error monitoring and logging
SENTRY_DSN=your_sentry_dsn_here
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# ═════════════ SECURITY HEADERS ═════════════
# Content Security Policy
CSP_ENABLED=false  # Enable in production
