# ═════════════════════════════════════════════════════════════
# FRONTEND ENVIRONMENT CONFIGURATION (.env)
# ═════════════════════════════════════════════════════════════
# IMPORTANT: This file contains PUBLIC configuration only.
# DO NOT commit sensitive data. All values here will be embedded in
# the frontend bundle and are visible to users. Use .gitignore to
# prevent .env from being committed.

# Firebase Web App Configuration
# Get these values from Firebase Console → Project Settings → Web App Config
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=shipguard-ai-thedevsumit44.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=shipguard-ai-thedevsumit44
VITE_FIREBASE_STORAGE_BUCKET=shipguard-ai-thedevsumit44.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_firebase_sender_id_here
VITE_FIREBASE_APP_ID=your_firebase_app_id_here
VITE_FIREBASE_MEASUREMENT_ID=your_firebase_measurement_id_here

# Backend API URL
# Production: Use HTTPS only
# Development: Can use HTTP for localhost
VITE_BACKEND_URL=http://localhost:8787

# API Retry Configuration
VITE_API_RETRY_ATTEMPTS=2
VITE_API_RETRY_DELAY_MS=350
VITE_API_TIMEOUT_MS=12000

# Session Configuration (minutes)
VITE_SESSION_TIMEOUT_MINUTES=480

# Admin Emails - Comma-separated list of admin users
# Example: admin1@company.com,admin2@company.com
VITE_ADMIN_EMAILS=your_admin_email@example.com

# Error Tracking (Optional - Sentry)
VITE_SENTRY_DSN=your_sentry_dsn_here
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1
