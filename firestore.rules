rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userDocPath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function role() {
      return signedIn() && exists(userDocPath())
        ? get(userDocPath()).data.role
        : null;
    }

    function isAdmin() {
      return role() == 'admin';
    }

    function isViewer() {
      return role() == 'viewer';
    }

    function canWriteOps() {
      return isAdmin();
    }

    function roleUnchanged() {
      return request.resource.data.role == resource.data.role;
    }

    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn()
                    && (
                      isAdmin()
                      || (request.auth.uid == uid && roleUnchanged())
                    );
      allow delete: if isAdmin();
    }

    match /shipments/{id} {
      allow read: if signedIn();
      allow create, update: if canWriteOps();
      allow delete: if isAdmin();

      // Notes subcollection - for viewer incident reports
      match /notes/{noteId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
        allow update, delete: if false;
      }
    }

    match /alerts/{id} {
      allow read: if signedIn();
      allow create, update: if canWriteOps();
      allow delete: if isAdmin();
    }

    match /interventions/{id} {
      allow read: if signedIn();
      allow create, update: if canWriteOps();
      allow delete: if isAdmin();
    }

    match /routeRecommendations/{id} {
      allow read: if signedIn();
      allow create, update: if canWriteOps();
      allow delete: if isAdmin();
    }

    match /audit_logs/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /webhook_retry_queue/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }

  }

}
